# --- LLM provider ---
# Pick ONE: "groq" (recommended: free, fast, instant signup), "gemini" (free tier),
# "openai", or "anthropic" (both paid). Only fill in the key for the one you pick.
LLM_PROVIDER=groq

# Get a free key in ~30 seconds at https://console.groq.com/keys
GROQ_API_KEY=gsk_...
# openai/gpt-oss-20b: free-tier available, fast, supports tool calling.
# (llama-3.3-70b-versatile is now an enterprise-only model on Groq — using it
# on a free account returns a 404 "model not found" error.)
GROQ_CHAT_MODEL=openai/gpt-oss-20b

# Free tier key at https://aistudio.google.com/apikey
GOOGLE_API_KEY=
GEMINI_CHAT_MODEL=gemini-1.5-flash

# Only needed if you switch LLM_PROVIDER to openai/anthropic
OPENAI_API_KEY=
OPENAI_CHAT_MODEL=gpt-4o-mini
ANTHROPIC_API_KEY=
ANTHROPIC_CHAT_MODEL=claude-3-5-haiku-latest

# --- Embeddings (RAG) ---
# "local" uses a free sentence-transformers model on your own machine — no API
# key, no account, works offline after the first download. Recommended.
EMBEDDING_PROVIDER=local
LOCAL_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
# Only used if you set EMBEDDING_PROVIDER=openai
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# --- Flask ---
FLASK_SECRET_KEY=change-me-please
FLASK_DEBUG=1

# --- Storage ---
# Leave DATABASE_URL unset to use an absolute path inside this project folder
# (instance/store.db) — this avoids "unable to open database file" errors
# that happen if a relative sqlite path doesn't match your current directory.
# Only set this if you want to point at a different database (e.g. Postgres).
# DATABASE_URL=sqlite:///instance/store.db
VECTOR_STORE_DIR=instance/vector_store
